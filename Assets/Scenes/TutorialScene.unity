--- !u!114 &1455987026
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5304083006189312999}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 70e7f8c222d59fd49b1b00351f563abf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  sprites:
  - {fileID: 21300000, guid: 54d3bad07b5d193468ea32eaee7403bd, type: 3}
  - {fileID: 21300000, guid: 54d3bad07b5d193468ea32eaee7403bd, type: 3}
  - {fileID: 21300000, guid: c2f62dc2312467b41887e94541db8631, type: 3}
  - {fileID: 21300000, guid: 3cc7f830999359846b8123b4285c8468, type: 3}
  - {fileID: 21300000, guid: e1eb9db74c809384288ea7b5c12a52ab, type: 3}
  - {fileID: 21300000, guid: deb676893ab84924f90595cce7ac2df9, type: 3}
  - {fileID: 21300000, guid: 7db1c1d504712a54d8163260641e8423, type: 3}
  - {fileID: 21300000, guid: abf2979b8da723548a5a031d56c02335, type: 3}
  - {fileID: 21300000, guid: f1df16ab2bada004cb28bf4a0fdfb65f, type: 3}
  - {fileID: 21300000, guid: 5e064659ed952c745bd1e2b6971db5df, type: 3}
  texts:
  - 
  - "EZ DO DEFENSE\uB294 \uC720\uB2DB\uC744 \uB79C\uB364\uC73C\uB85C \uBF51\uC544
    \uBAB0\uB824\uC624\uB294 \uC801\uC744 \uC800\uC9C0\uD558\uB294 \uB79C\uB364 \uD0C0\uC6CC
    \uB514\uD39C\uC2A4 \uAC8C\uC784\uC785\uB2C8\uB2E4.  \uC2A4\uD14C\uC774\uC9C0\uAC00
    \uC2DC\uC791\uB418\uBA74 \uC801\uC774 \uB4F1\uC7A5\uD558\uBA70, \uC2A4\uD14C\uC774\uC9C0\uB294
    1\uBD80\uD130 100\uAE4C\uC9C0 \uC874\uC7AC\uD569\uB2C8\uB2E4. "
  - "\uC88C\uCE21 \uC0C1\uB2E8\uC5D0 \uC704\uCE58\uD55C \uC5D0\uB108\uBBF8 \uCE74\uC6B4\uD2B8\uB294
    \uB9F5\uC5D0 \uC874\uC7AC\uD558\uB294 \uC801\uC758 \uC22B\uC790\uB97C \uC758\uBBF8\uD569\uB2C8\uB2E4. 
    \uB9CC\uC57D, \uC5D0\uB108\uBBF8 \uCE74\uC6B4\uD2B8\uAC00 100\uC774 \uB3C4\uB2EC\uB420
    \uC2DC 30\uCD08 \uAC04\uC758 \uC720\uC608 \uC2DC\uAC04\uC774 \uC8FC\uC5B4\uC9C0\uBA70 
    \uC774 \uC720\uC608 \uC2DC\uAC04 \uB0B4\uC5D0 \uC5D0\uB108\uBBF8 \uCE74\uC6B4\uD2B8\uB97C
    100 \uBBF8\uB9CC\uC73C\uB85C \uB9CC\uB4E4\uC9C0 \uBABB\uD560 \uACBD\uC6B0 \uD50C\uB808\uC774\uC5B4\uB294
    \uD328\uBC30\uD569\uB2C8\uB2E4. "
  - "10\uC758 \uBC30\uC218 \uC2A4\uD14C\uC774\uC9C0\uB294 \uBCF4\uC2A4 \uC2A4\uD14C\uC774\uC9C0\uB85C
    \uBCF4\uC2A4\uAC00 \uB4F1\uC7A5\uD569\uB2C8\uB2E4.  \uBCF4\uC2A4 \uBAAC\uC2A4\uD130\uB97C
    1\uBD84 \uC774\uB0B4\uC5D0 \uC81C\uAC70\uD558\uC9C0 \uBABB\uD558\uBA74 \uC774
    \uC5ED\uC2DC \uD50C\uB808\uC774\uC5B4\uB294 \uD328\uBC30\uD569\uB2C8\uB2E4. \uD50C\uB808\uC774\uC5B4\uAC00
    \uC2B9\uB9AC\uD558\uAE30 \uC704\uD574\uC11C\uB294 100\uC2A4\uD14C\uC774\uC9C0\uAE4C\uC9C0
    \uB4F1\uC7A5\uD558\uB294 \uBAA8\uB4E0 \uC801\uC744 \uC81C\uAC70\uD574\uC57C \uD569\uB2C8\uB2E4. "
  - "\uD50C\uB808\uC774\uC5B4\uB294 \uB124 \uC885\uB958\uC758 \uBF51\uAE30 \uC911
    \uC6D0\uD558\uB294 \uC885\uB958\uC758 \uBF51\uAE30\uB97C \uD0DD\uD574 \uC720\uB2DB\uC744
    \uBF51\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.  \uBF51\uAE30\uC758 \uC885\uB958\uB9C8\uB2E4
    \uB4F1\uC7A5\uD558\uB294 \uC720\uB2DB\uC758 \uACF5\uACA9 \uD0C0\uC785\uC774 \uB2E4\uB974\uBA70,
    \uC720\uB2DB\uC744 \uBF51\uAE30 \uC704\uD574\uC120 \uACE8\uB4DC\uAC00 \uD544\uC694\uD569\uB2C8\uB2E4. 
    \uB9CC\uC57D, \uACE8\uB4DC\uAC00 \uBD80\uC871\uD558\uAC70\uB098 \uC720\uB2DB\uC744
    \uBC30\uCE58\uD560 \uC218 \uC788\uB294 \uCE78\uC774 \uC5C6\uC744 \uC2DC \uBF51\uAE30\uB294
    \uBD88\uAC00\uD569\uB2C8\uB2E4. "
  - "\uC720\uB2DB \uAC04\uC5D0\uB294 \uD0C0\uC785\uC5D0 \uC758\uD574 \uC0C1\uC131\uC774
    \uC874\uC7AC\uD569\uB2C8\uB2E4.  \uC0C1\uC131\uC740 \uC720\uB9AC, \uBD88\uB9AC\uB85C
    \uB098\uB220\uC9C0\uBA70 \uC720\uB9AC\uD55C \uC0C1\uC131\uC77C \uB54C\uB294 120%\uC758
    \uB370\uBBF8\uC9C0\uB97C \uC785\uD788\uBA70, \uBD88\uB9AC\uD560 \uB550 80%\uC758
    \uB370\uBBF8\uC9C0\uB97C \uC785\uD799\uB2C8\uB2E4.  \uADF8 \uC678\uC5D4 100%\uC758
    \uB370\uBBF8\uC9C0\uB97C \uC785\uD799\uB2C8\uB2E4. "
  - "\uAC19\uC740 \uC720\uB2DB\uC774 \uC138 \uB9C8\uB9AC \uC874\uC7AC\uD560 \uACBD\uC6B0
    \uC720\uB2DB\uC758 \uC870\uD569\uC774 \uAC00\uB2A5\uD569\uB2C8\uB2E4.  \uC720\uB2DB\uC744
    \uC870\uD569\uD560 \uACBD\uC6B0 \uAC19\uC740 \uACF5\uACA9 \uD0C0\uC785\uC758
    \uC0C1\uC704 \uB4F1\uAE09 \uC720\uB2DB \uC911 \uB79C\uB364\uC73C\uB85C \uD55C
    \uB9C8\uB9AC\uB97C \uC5BB\uAC8C \uB429\uB2C8\uB2E4. "
  - "\uD50C\uB808\uC774\uC5B4\uB294 \uACE8\uB4DC\uB098 \uBCF4\uC11D\uC744 \uC18C\uBAA8\uD558\uC5EC
    \uC720\uB2DB\uC744 \uAC15\uD654\uD558\uC5EC \uACF5\uACA9\uB825\uACFC \uACF5\uACA9
    \uC18D\uB3C4\uB97C \uC62C\uB9B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uAC15\uD654\uC758
    \uC885\uB958\uB294 \uD06C\uAC8C \uACF5\uACA9 \uD0C0\uC785 \uAC15\uD654\uC640
    \uB4F1\uAE09 \uAC15\uD654\uB85C \uB098\uB220\uC9D1\uB2C8\uB2E4.  "
  - "\uC6B0\uCE21 \uC0C1\uB2E8\uC5D0 \uC704\uCE58\uD55C \uD1B1\uB2C8\uBC14\uD034
    \uC544\uC774\uCF58\uC744 \uD074\uB9AD\uD558\uBA74 BGM\uC640 SFX \uB4F1\uC758
    \uC870\uC808\uC774 \uAC00\uB2A5\uD55C \uC124\uC815\uCC3D\uC73C\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4.
    \uC124\uC815\uCC3D\uC744 \uCF1C \uB454 \uC0C1\uD0DC\uC5D0\uC120 \uD3B8\uC758\uC131\uC744
    \uC704\uD574 \uAC8C\uC784\uC774 \uC77C\uC2DC\uC815\uC9C0 \uB429\uB2C8\uB2E4.
    \uC124\uC815\uCC3D\uC744 \uB04C \uACBD\uC6B0 \uB2E4\uC2DC \uAC8C\uC784\uC774
    \uC9C4\uD589\uB429\uB2C8\uB2E4.  "
  - "EZ DO DEFENSE\uB294 \uC720\uB2DB\uC744 \uB79C\uB364\uC73C\uB85C \uBF51\uC544
    \uBAB0\uB824\uC624\uB294 \uC801\uC744 \uC800\uC9C0\uD558\uB294 \uB79C\uB364 \uD0C0\uC6CC
